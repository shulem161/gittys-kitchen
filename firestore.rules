rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // The owner is the account saved in meta/admin. Until that exists,
    // it is whoever owns the name "Shulem Schlesinger".
    function isOwner() {
      let m = /databases/$(database)/documents/meta/admin;
      let k = /databases/$(database)/documents/names/$('shulem schlesinger');
      return signedIn()
        && ((exists(m) && get(m).data.uid == request.auth.uid)
            || (!exists(m) && exists(k) && get(k).data.uid == request.auth.uid));
    }
    function ownerUid() {
      let m = /databases/$(database)/documents/meta/admin;
      return exists(m) ? get(m).data.uid : '';
    }

    // Roles: "admin" (chosen by the owner), "employee" (what members could always do), "public" (limited).
    // A profile without a role counts as public.
    function approvedMember() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'public');
    }
    function isAdmin() { return isOwner() || (approvedMember() && myRole() == 'admin'); }
    function isTeam() { return isAdmin() || (approvedMember() && myRole() == 'employee'); }
    // Employee settings (meta/employees) for all employees; a person's own perms override them.
    function empAllow(k, d) {
      let e = /databases/$(database)/documents/meta/employees;
      return exists(e) ? get(e).data.get('allow', {}).get(k, d) : d;
    }
    // Everyday permissions: employees per Employee settings / their own perms (on unless switched off);
    // public members share meta/public (on unless switched off). Admins can always.
    function can(k) {
      let p = /databases/$(database)/documents/meta/public;
      let me = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isAdmin()
        || (approvedMember()
            && ((me.get('role', 'public') == 'employee' && me.get('perms', {}).get(k, empAllow(k, true)) == true)
                || (me.get('role', 'public') == 'public' && (!exists(p) || get(p).data.get('allow', {}).get(k, true) == true))));
    }
    // Extra permissions an admin grants one employee at a time (off unless granted).
    function extra(k) {
      let me = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isAdmin()
        || (approvedMember() && me.get('role', 'public') == 'employee' && me.get('perms', {}).get(k, empAllow(k, false)) == true);
    }
    // Who may write recipes: admins, and employees allowed to approve (only admins edit; everyone else requests a change).
    // Those employees can't change whether the public sees a recipe; new recipes follow their category.
    function publishOk() {
      let p = /databases/$(database)/documents/meta/public;
      return isAdmin()
        || (extra('review')
            && (resource == null
                ? request.resource.data.get('pub', true) == (!exists(p) || get(p).data.get('cats', {}).get(request.resource.data.c, true) != false)
                : request.resource.data.get('pub', null) == resource.data.get('pub', null)));
    }
    // A merge in Ready to release that says recipe rid is to be deleted when it's released
    function mergeDrops(rid) {
      let s = get(/databases/$(database)/documents/submissions/$(request.resource.data.mergedBy)).data;
      return s.get('dropOf', '') == rid && s.get('stage', '') == 'release' && s.get('status', '') == 'pending';
    }
    // Recipe inboxes: three different people. Whoever proofread can't approve; neither of them can release.
    // Ordinary edits never move a recipe between inboxes
    function noRvChange() {
      return resource == null || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rv', 'rvUids', 'rvAsk', 'rvLog', 'rvNote', 'rvNoteBy']);
    }
    // Only one step at a time, in order; nobody takes two steps; who moved it before is never wiped out.
    // Public or team only changes only when it's released from Ready to release.
    function rvSteps() {
      let was = resource.data.get('rv', '');
      let now = request.resource.data.get('rv', '');
      let pubSame = request.resource.data.get('pub', null) == resource.data.get('pub', null);
      let before = resource.data.get('rvUids', []);
      let after = request.resource.data.get('rvUids', []);
      // the person moving it is written down, or it goes on the name of whoever asked (they can't take the next step; whoever tapped can)
      let noted = request.auth.uid in after || resource.data.get('rvAsk', []).size() > 0;
      return (pubSame
          && ((was == now && after == before)                                              // a note, nothing moves
              || (now == 'proof' && was in ['', 'proof', 'approve', 'release'] && after.size() == 0)   // back to the start
              || (was == 'release' && now == 'approve' && before.hasAll(after)))          // undo one step
          && (extra('proofread') || extra('review') || extra('release')))
        || (was == 'proof' && now == 'approve' && pubSame && after.hasAll(before) && noted && extra('proofread'))
        || (was == 'approve' && now == 'release' && pubSame && after.hasAll(before) && noted
            && !(request.auth.uid in before) && extra('review'))
        || (was == 'release' && now == '' && after.hasAll(before)
            && !(request.auth.uid in before) && extra('release'));
    }
    // Not kosher: only admins put a recipe there and take it out
    function kosherMove() {
      return resource != null
        && (request.resource.data.get('rv', '') == 'kosher' || resource.data.get('rv', '') == 'kosher')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rv', 'rvNote', 'rvNoteBy', 'rvBy', 'rvAt', 'rvUids', 'rvAsk', 'rvLog', 'pub', 'kosherFrom', 'kosherPub', 'yoelyFrom', 'priv', 'hu'])
        && isAdmin();
    }
    // Private (the Yoely inbox): a recipe that went through it is marked priv and stays in the family.
    // Nobody can make it public or take the mark off, except the owner (his exception). Cheap checks first.
    function privOk() {
      let np = request.resource.data.get('priv', false) == true;
      let op = resource != null && resource.data.get('priv', false) == true;
      return ((!np || request.resource.data.get('pub', false) != true
                || (op && resource.data.get('pub', false) == true))
              && (np || !op))
        || isOwner();
    }
    // Yoely: an inbox before the three steps (admins, and employees given the Yoely inbox).
    // In from nowhere or Need to proofread; cleared, straight to For approval with whoever cleared it written down
    // (so they can't approve or release it too); taken out, back where it was.
    function yoelyMove() {
      let was = resource.data.get('rv', '');
      let now = request.resource.data.get('rv', '');
      let after = request.resource.data.get('rvUids', []);
      return resource != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rv', 'rvUids', 'rvAsk', 'rvBy', 'rvAt', 'rvLog', 'rvNote', 'rvNoteBy', 'yoelyFrom', 'priv', 'pub', 'hu'])
        && (request.resource.data.get('pub', null) == resource.data.get('pub', null) || request.resource.data.get('pub', true) == false)
        && ((was in ['', 'proof'] && now == 'yoely' && after.size() == 0 && request.resource.data.get('yoelyFrom', '') == was)
            || (was == 'yoely' && now == 'approve' && request.auth.uid in after)
            || (was == 'yoely' && now == resource.data.get('yoelyFrom', '') && after.size() == 0))
        && extra('yoely');
    }
    // Manage → Move between inboxes (admins): among Need to proofread, Private, Grandma's Hungarian Recipes (Private marked hu) and Not kosher, both ways.
    // Not one of the three steps: nobody is written down (rvUids empty); the reason goes in the log.
    function inboxMoveOk() {
      let was = resource.data.get('rv', '');
      let now = request.resource.data.get('rv', '');
      return resource != null && was in ['proof', 'yoely', 'kosher'] && now in ['proof', 'yoely', 'kosher']
        && (was != now || request.resource.data.get('hu', false) != resource.data.get('hu', false))
        && request.resource.data.get('rvUids', []).size() == 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rv', 'rvUids', 'rvAsk', 'rvBy', 'rvAt', 'rvLog', 'rvNote', 'rvNoteBy', 'kosherFrom', 'kosherPub', 'pub', 'yoelyFrom', 'priv', 'hu'])
        && isAdmin();
    }
    // An edit to a recipe in For approval or Ready to release sends it back to Need to proofread, in the same save
    function editedBack() {
      return resource != null
        && resource.data.get('rv', '') in ['approve', 'release'] && request.resource.data.get('rv', '') == 'proof'
        && request.resource.data.get('rvUids', []).size() == 0;
    }
    // Is this person on a watch list (meta/watch-proof, meta/reqwatch, meta/ratewatch)? Customers may notify them.
    function onWatch(w, uid) {
      let d = /databases/$(database)/documents/meta/$(w);
      return exists(d) && uid in get(d).data.get('uids', []);
    }
    // Admins may manage employees and public members, but never the owner or another admin.
    function canManage(uid) {
      return isOwner()
        || (isAdmin() && uid != ownerUid() && uid != request.auth.uid
            && get(/databases/$(database)/documents/users/$(uid)).data.get('role', 'public') != 'admin');
    }

    // Recipe code numbers per category and per Pesach section. Members read, only the admin writes.
    // The design everyone gets (chosen by an admin).
    match /meta/look {
      allow get: if signedIn();
      allow write: if isAdmin();
    }

    // Pairs of recipes an admin marked "not duplicates".
    // The Claude reader's address (a Cloudflare Worker that keeps the Anthropic key secret): set by the owner
    match /meta/claude {
      allow get: if approvedMember();
      allow write: if isOwner() && request.resource.data.keys().hasOnly(['url', 'at'])
        && request.resource.data.url is string && (request.resource.data.url == '' || request.resource.data.url.matches('https://.+'));
    }
    match /meta/dupes {
      allow get: if isAdmin();
      allow write: if isAdmin() && request.resource.data.keys().hasOnly(['ignore']) && request.resource.data.ignore is list;
    }

    // What every employee may do (Employee settings).
    match /meta/employees {
      allow get: if signedIn();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['allow'])
        && request.resource.data.allow is map;
    }

    // What public members may do, and each category's setting for new recipes.
    match /meta/public {
      allow get: if signedIn();
      allow write: if (isAdmin() || extra('portal'))
        && request.resource.data.keys().hasOnly(['allow', 'cats'])
        && request.resource.data.allow is map && request.resource.data.cats is map;
    }
    // Member numbers: the next one to give out
    match /meta/counter {
      allow get, write: if isAdmin();
    }
    // Customers, for employees allowed to log in as one
    match /meta/customers {
      allow get: if isAdmin() || extra('viewas');
      allow write: if isAdmin() && request.resource.data.keys().hasOnly(['list']) && request.resource.data.list is list;
    }
    // Likes and dislikes on recipes: everyone rates for themselves; admins see them all.
    match /ratings/{id} {
      allow get: if signedIn() && (id.matches('.*_' + request.auth.uid) || extra('ratings'));
      allow list: if extra('ratings');
      allow create, update: if approvedMember() && id == request.resource.data.rid + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.v in [1, -1]
        && (request.resource.data.v == 1 || request.resource.data.reason in ['unclear', 'notgood', 'photo', 'amounts', 'timeheat', 'noing', 'nostep', 'hard', 'other'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 400
        && request.resource.data.keys().hasOnly(['rid', 'uid', 'name', 'v', 'reason', 'text', 'at']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    // Who hears about likes and dislikes (admins, and employees allowed to see them).
    match /meta/ratewatch {
      allow get: if approvedMember();
      allow write: if isAdmin() && request.resource.data.keys().hasOnly(['uids'])
        && request.resource.data.uids is list && request.resource.data.uids.size() <= 300;
    }
    // Who hears about new recipe requests (admins, and employees allowed to answer them).
    match /meta/reqwatch {
      allow get: if approvedMember();
      allow write: if isAdmin() && request.resource.data.keys().hasOnly(['uids'])
        && request.resource.data.uids is list && request.resource.data.uids.size() <= 300;
    }
    // Who is on the team (owner, admins, employees), so employees can pick who to write to.
    match /meta/team {
      allow get: if isTeam();
      allow write: if isAdmin() && request.resource.data.keys().hasOnly(['list'])
        && request.resource.data.list is list && request.resource.data.list.size() <= 300;
    }
    // Owner's view: the owner OKs a new version of the site here before admins, employees and customers get it.
    match /meta/release {
      allow get: if isOwner();
      allow write: if isOwner() && request.resource.data.keys().hasOnly(['approve', 'by', 'at', 'live', 'liveAt'])
        && request.resource.data.approve is string;
    }
    // Owner's view: which new features are switched on for everyone. Everyone reads it (also a removed member,
    // for "Ask to join again"); only the owner switches.
    match /meta/features {
      allow get: if signedIn();
      allow write: if isOwner() && request.resource.data.keys().hasOnly(['on', 'by', 'at']) && request.resource.data.on is map;
    }
    // History: each saved version of a recipe, kept for the team. Written once, never changed.
    match /versions/{id} {
      allow read: if isTeam();
      allow create: if isTeam() && request.resource.data.rid is string
        && (request.resource.data.uid == request.auth.uid || request.resource.data.uid == '');
    }
    // AI menus: each one made, and the 👍/👎 its maker gave it. Everyone signed in may read them (no names inside),
    // so the AI can learn from the whole family; only the maker rates their own.
    match /menuideas/{id} {
      allow read: if approvedMember();
      // an AI menu starts unrated; a menu someone made themselves (src own) counts as liked
      allow create: if approvedMember() && request.resource.data.uid == request.auth.uid
        && ((request.resource.data.v == 0 && request.resource.data.keys().hasOnly(['uid', 'at', 'request', 'courses', 'title', 'picks', 'v']))
            || (request.resource.data.v == 1 && request.resource.data.get('src', '') == 'own' && id.matches('own-.*')
                && request.resource.data.keys().hasOnly(['uid', 'at', 'request', 'title', 'picks', 'v', 'src']))
            // a good menu the team photographed (menuphoto): it counts as liked
            || (request.resource.data.v == 1 && request.resource.data.get('src', '') == 'photo' && id.matches('photo-.*') && isTeam()
                && request.resource.data.keys().hasOnly(['uid', 'at', 'request', 'title', 'picks', 'v', 'src'])))
        && request.resource.data.request is string && request.resource.data.request.size() <= 300
        && request.resource.data.picks is list && request.resource.data.picks.size() <= 12;
      allow update: if approvedMember() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid
        && ((!(resource.data.get('src', '') in ['own', 'photo'])
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['v', 'reason', 'text', 'ratedAt'])
             && request.resource.data.v in [1, -1] && request.resource.data.get('text', '') is string && request.resource.data.get('text', '').size() <= 300)
          || (resource.data.get('src', '') == 'own'
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'request', 'picks', 'at'])
             && request.resource.data.request.size() <= 300 && request.resource.data.picks is list && request.resource.data.picks.size() <= 12));
      // a photographed menu can be taken back by whoever kept it, or an admin
      allow delete: if resource.data.get('src', '') == 'photo' && isTeam() && (resource.data.uid == request.auth.uid || isAdmin());
    }
    // Who sees the names on AI menus (Inbox settings). Admins choose.
    match /meta/menunames {
      allow get: if approvedMember();
      allow write: if isAdmin() && request.resource.data.keys().hasOnly(['show'])
        && request.resource.data.show in ['none', 'owner', 'admin', 'ratings'];
    }
    match /meta/codes {
      allow get: if signedIn();
      allow write: if isAdmin() || extra('review') || extra('moverec');
    }

    // Who the owner is and the name shown for them. Only the owner can change it, and only to themselves.
    match /meta/admin {
      allow get: if true;
      allow write: if (isOwner()
            || (signedIn() && exists(/databases/$(database)/documents/meta/admin)
                && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.from == get(/databases/$(database)/documents/meta/admin).data.uid))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 40;
    }

    // One entry per member name, so every name is unique.
    match /names/{key} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email']);
      allow delete: if (isAdmin() && canManage(resource.data.uid)) || (signedIn() && resource.data.uid == request.auth.uid);
      // Someone who now signs in with their own email clears the made-up address on their name.
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email']) && request.resource.data.email == '';
      // Forgot password: a valid reset or recovery code moves the name to a new sign-in.
      allow update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'code'])
        && request.resource.data.code is string
        && exists(/databases/$(database)/documents/resets/$(request.resource.data.code))
        && get(/databases/$(database)/documents/resets/$(request.resource.data.code)).data.key == key
        && get(/databases/$(database)/documents/resets/$(request.resource.data.code)).data.uid == resource.data.uid
        && (get(/databases/$(database)/documents/resets/$(request.resource.data.code)).data.expires == null
            || get(/databases/$(database)/documents/resets/$(request.resource.data.code)).data.expires > request.time.toMillis());
    }

    // Reset codes (from the admin, 2 days) and recovery codes (made by the member, no end date).
    // The code itself is the document id and the secret: it can be read only by someone who knows it.
    match /resets/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if code.size() >= 8
        && request.resource.data.keys().hasOnly(['key', 'uid', 'by', 'created', 'expires'])
        && exists(/databases/$(database)/documents/names/$(request.resource.data.key))
        && get(/databases/$(database)/documents/names/$(request.resource.data.key)).data.uid == request.resource.data.uid
        && ((isAdmin() && canManage(request.resource.data.uid) && request.resource.data.by == 'admin'
              && request.resource.data.expires is int
              && request.resource.data.expires <= request.time.toMillis() + 3 * 86400000)
            || (signedIn() && request.resource.data.by == 'self' && code.size() >= 12
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.expires == null));
      allow delete: if isAdmin()
        || (signedIn() && (resource.data.uid == request.auth.uid
            || get(/databases/$(database)/documents/names/$(resource.data.key)).data.uid == request.auth.uid));
    }

    // Recipes: employees and admins read all; public members only recipes marked pub == true.
    // Only admins add, edit or delete.
    match /recipes/{id} {
      allow read: if isAdmin()
        || (approvedMember() && (myRole() != 'public' || resource.data.get('pub', false) == true));
      // Only admins move recipes to another category; employees ask (golive, kind "move").
      // anyone on the team can ask for a recipe to be moved up, or put a hidden one into Need to proofread
      // (Cheap checks come first and the costly role lookups last: Firebase stops checking after 1,000 steps per save.)
      allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rvAsk'])
        // edited, or undone by whoever moved it: back one step, or back to Need to proofread
        || (((resource.data.get('rv', '') in ['approve', 'release'] && request.resource.data.get('rv', '') == 'proof' && request.resource.data.get('rvUids', []).size() == 0)
             || (resource.data.get('rv', '') == 'release' && request.resource.data.get('rv', '') == 'approve'
                 && resource.data.get('rvUids', []).hasAll(request.resource.data.get('rvUids', []))))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rv', 'rvUids', 'rvAsk', 'rvBy', 'rvAt', 'rvLog']))
        || (resource.data.get('rv', '') == '' && request.resource.data.get('rv', '') == 'proof'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rv', 'rvUids', 'rvAsk', 'rvBy', 'rvAt', 'rvLog'])))
        && isTeam();
      // Merging: whoever releases the merged recipe deletes the one that was merged into it (and nothing else).
      // Checked first, and only for that change, to stay within the rules' limit on document lookups.
      // Then the one-job privileges (each only when the save touches just its own fields), then the general cases.
      allow write: if privOk() && (
           (resource != null && resource.data.get('deleted', false) == false
            && request.resource.data.get('deleted', false) == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'deletedAt', 'deletedBy', 'updated', 'mergedBy'])
            && mergeDrops(id) && extra('release'))
        // Employees given "Delete recipes": delete one (it goes to the Recycle bin)
        || (resource != null && request.resource.data.get('deleted', false) == true && resource.data.get('deleted', false) == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'deletedAt', 'deletedBy', 'updated']) && extra('del'))
        // Recycle bin: employees allowed to delete may also restore (with a new number if the old one was taken)
        || (resource != null && resource.data.get('deleted', false) == true && request.resource.data.get('deleted', true) == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'restoredAt', 'restoredBy', 'updated', 'code', 'oldCodes']) && extra('del'))
        || (resource != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['c', 'sec', 'code', 'oldCodes', 'history', 'updated']) && extra('moverec'))
        || (resource != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pub', 'updated']) && extra('pub'))
        // Employees allowed to change labels: meal, dish type, dairy/meat/pareve, good for Pesach
        || (resource != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['meals', 'dish', 'kind', 'pesach', 'snackKind', 'updated']) && extra('labels'))
        // Employees given "Edit recipes directly": the recipe itself only, never where it is, who sees it or whether it's deleted
        || (resource != null && resource.data.get('deleted', false) == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['t', 'by', 'n', 'pre', 'kind', 'time', 'serves', 's', 'also', 'history', 'updated'])
            && extra('editdirect'))
        || ((noRvChange() || editedBack()) && publishOk())
        || kosherMove()
        || yoelyMove()
        || inboxMoveOk()
        || (resource != null && (resource.data.get('rv', '') == 'kosher' || request.resource.data.get('rv', '') == 'kosher')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rv', 'rvUids', 'rvAsk', 'rvBy', 'rvAt', 'rvLog', 'rvNote', 'rvNoteBy', 'pub', 'kosherPub', 'kosherFrom', 'yoelyFrom', 'priv', 'hu'])
            && extra('kosher'))
        // Recipe inboxes: proofreaders, approvers and releasers move a recipe along (rv), one step at a time;
        // releasers choose public or team only
        || (resource != null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rv', 'rvNote', 'rvNoteBy', 'rvBy', 'rvAt', 'rvUids', 'rvAsk', 'rvLog', 'pub'])
            && rvSteps()));
    }

    // Employees asking for a recipe to be shown to public members. Admins decide.
    match /golive/{id} {
      allow create: if approvedMember() && myRole() == 'employee'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.keys().hasOnly(['uid', 'byName', 'rid', 'title', 'status', 'created', 'kind', 'to', 'sec', 'from']);
      allow read: if isAdmin() || extra('release') || extra('review') || extra('moverec') || extra('pub') || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin() || extra('release') || extra('review') || extra('moverec') || extra('pub');
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Who hears about each recipe inbox (admins, and employees allowed to work in it).
    match /meta/{w} {
      allow get: if approvedMember() && w in ['watch-proof', 'watch-approve', 'watch-release', 'watch-yoely'];
      allow write: if isAdmin() && w in ['watch-proof', 'watch-approve', 'watch-release', 'watch-yoely']
        && request.resource.data.keys().hasOnly(['uids']) && request.resource.data.uids is list;
    }

    // Who handled a member recipe (uids) is never wiped out: moving it on adds the mover, going back to
    // Need to proofread starts over, and undoing a move takes off only the person undoing it, one step back.
    function subUidsOk() {
      let ou = resource.data.get('uids', []);
      let nu = request.resource.data.get('uids', []);
      let os = resource.data.get('stage', 'approve');
      let ns = request.resource.data.get('stage', 'approve');
      return (nu == ou && (ns == os || ns == 'proof' || (os == 'release' && ns == 'approve') || (os == 'kosher' && ns == 'yoely')))
        || (ns == 'proof' && nu.size() == 0)
        || (nu == ou.concat([request.auth.uid]) && !(request.auth.uid in ou)
            && ((os in ['proof', 'yoely'] && ns == 'approve') || (os == 'approve' && ns == 'release')))
        || (request.auth.uid in ou && nu == ou.removeAll([request.auth.uid])
            && ((os == 'release' && ns == 'approve') || (os == 'approve' && ns == 'proof')));
    }
    // Item numbers given to new recipes waiting in the inboxes, so no number is given twice and a declined one stays taken a year.
    // The team reads them; people who work in the inboxes take a number (never one already taken) and update when it was last used.
    match /codeholds/{code} {
      allow read: if isTeam();
      allow create: if (extra('proofread') || extra('review') || extra('release'))
        && request.resource.data.keys().hasOnly(['sid', 'at', 'by', 'code'])
        && request.resource.data.code == code && request.resource.data.sid is string && request.resource.data.at is int;
      allow update: if (extra('proofread') || extra('review') || extra('release'))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['at']) && request.resource.data.at is int;
    }

    // Activity log: a short line for things that leave no other trace (a photo added or approved, a menu made).
    // Each person writes only their own lines; admins and employees allowed to see Activity read them; nobody changes them.
    match /activity/{id} {
      allow read: if isAdmin() || extra('activity');
      allow create: if approvedMember()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['kind', 'by', 'uid', 't', 'rid', 'at'])
        && request.resource.data.kind in ['photo', 'photook', 'menu']
        && request.resource.data.t is string && request.resource.data.t.size() <= 120
        && request.resource.data.at is int;
      allow delete: if isAdmin();
    }

    // Scanner readings remembered by the file's fingerprint (scanexact), so the same file always gives the same recipes.
    // Members read them; anyone who can scan adds one; nobody changes one (only admins delete).
    match /scans/{key} {
      allow get: if approvedMember();
      allow create: if approvedMember() && key.size() == 64
        && request.resource.data.keys().hasOnly(['json', 'at', 'by'])
        && request.resource.data.json is string && request.resource.data.json.size() < 400000
        && request.resource.data.at is int;
      // a reading can only grow: recipes that were missed are added to it
      allow update: if approvedMember()
        && request.resource.data.keys().hasOnly(['json', 'at', 'by'])
        && request.resource.data.json is string && request.resource.data.json.size() < 400000
        && request.resource.data.json.size() > resource.data.json.size()
        && request.resource.data.at is int;
      allow delete: if isAdmin();
    }

    // Recipes sent in by members. Only the admin sees all of them and decides.
    match /submissions/{id} {
      // a new one starts in Need to proofread; admins and employees given "Choose the first inbox" may start it in Yoely or Not kosher
      allow create: if request.resource.data.status == 'pending'
        && (request.resource.data.get('stage', '') == 'proof' || (request.resource.data.get('stage', '') in ['yoely', 'kosher'] && extra('scanto')))
        && (can('suggest') || extra('edit') || isAdmin())
        && (request.resource.data.uid == request.auth.uid || (isAdmin() && canManage(request.resource.data.uid)));
      allow read: if extra('review') || extra('proofread') || extra('release') || extra('yoely') || extra('kosher') || (signedIn() && resource.data.uid == request.auth.uid);
      // three different people: whoever proofread can't approve; neither of them can release
      allow update: if (extra('review') || extra('proofread') || extra('release')
          || (resource.data.get('stage', '') == 'yoely' && extra('yoely')) || (resource.data.get('stage', '') == 'kosher' && extra('kosher')))
        && (request.resource.data.get('stage', '') != 'release' || resource.data.get('stage', '') == 'release'
            || !(request.auth.uid in resource.data.get('uids', [])))
        && (request.resource.data.status != 'approved' || resource.data.status == 'approved'
            || !(request.auth.uid in resource.data.get('uids', [])))
        && (isAdmin() || subUidsOk());
      allow delete: if extra('review')
        || (signedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'pending');
    }

    // Photos of finished dishes. Members' photos wait for an admin's approval.
    match /photos/{id} {
      allow create: if can('photos')
        && request.resource.data.uid == request.auth.uid
        && (request.resource.data.status == 'pending'
            || (request.resource.data.status == 'approved' && extra('review')))
        && request.resource.data.img is string && request.resource.data.img.size() < 900000
        && request.resource.data.thumb is string && request.resource.data.thumb.size() < 80000;
      allow read: if extra('review')
        || (signedIn() && resource.data.uid == request.auth.uid)
        || (resource.data.status == 'approved' && approvedMember());
      allow update: if extra('review');
      allow delete: if extra('review')
        || (signedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'pending');
    }

    // Suggestions and comments from members. Only the admin sees them all and can reply.
    match /feedback/{id} {
      allow create: if can('feedback')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.reply == ''
        && request.resource.data.text is string && request.resource.data.text.size() <= 1500;
      allow read: if extra('inbox') || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if extra('inbox');
      allow delete: if extra('inbox') || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Recipe requests from members ("I need a recipe for…", optional small photo). Only the admin sees them all.
    match /requests/{id} {
      allow create: if can('requests')
        && (request.resource.data.uid == request.auth.uid || (isAdmin() && canManage(request.resource.data.uid)))
        && request.resource.data.status == 'open'
        && request.resource.data.reply == '' && request.resource.data.recipeId == ''
        && request.resource.data.items is list && request.resource.data.items.size() <= 12
        && request.resource.data.text is string && request.resource.data.text.size() <= 800
        && request.resource.data.photo is string && request.resource.data.photo.size() < 120000;
      allow read: if extra('answer') || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if extra('answer');
      allow delete: if extra('answer') || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Each person's own calendar: only they can see or change it.
    // everything personal that goes with the account (grocery list, Today list, checked-off steps, settings): only its owner
    match /mine/{uid} {
      allow read, write: if approvedMember() && request.auth.uid == uid;
    }
    match /plans/{uid} {
      allow read, write: if approvedMember() && request.auth.uid == uid;
      // "Log in as": an admin can change the calendar of someone they manage
      allow write: if isAdmin() && canManage(uid);
      // "Log in as": admins, and employees allowed to look in as a customer
      allow read: if isAdmin() || (extra('viewas') && get(/databases/$(database)/documents/users/$(uid)).data.get('role', 'public') == 'public');
    }

    // Menus: the person who made one changes it; people it's shared with can read it.
    // Phone notices: each person's own private ntfy topic. The team may read it to send them a notice; customers only for people on a watch list.
    match /notify/{uid} {
      allow get: if isTeam() || (approvedMember() && (onWatch('watch-proof', uid) || onWatch('reqwatch', uid) || onWatch('ratewatch', uid)));
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['topic'])
        && request.resource.data.topic is string
        && request.resource.data.topic.size() >= 16 && request.resource.data.topic.size() <= 64;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Team messages: only employees and admins, and only the people in the conversation.
    match /threads/{id} {
      allow read: if (isTeam() && request.auth.uid in resource.data.members) || isAdmin();
      allow create: if isTeam()
        && request.resource.data.by == request.auth.uid && request.resource.data.lastBy == request.auth.uid
        && request.resource.data.members is list && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() <= 300
        && request.resource.data.msgs is list && request.resource.data.msgs.size() == 1
        && request.resource.data.msgs[0].by == request.auth.uid
        && request.resource.data.msgs[0].text is string && request.resource.data.msgs[0].text.size() <= 1500;
      allow update: if isTeam() && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['msgs', 'updated', 'lastBy', 'readAt', 'done', 'checks', 'unreadFor'])
        // proofreading: each person marks only their own check
        && (!('checks' in request.resource.data) || request.resource.data.checks.diff(resource.data.get('checks', {})).affectedKeys().hasOnly([request.auth.uid]))
        && request.resource.data.msgs is list && request.resource.data.msgs.size() <= 200
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastBy'])
            || request.resource.data.lastBy == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /menus/{id} {
      allow read: if isAdmin() || (approvedMember()
        && (resource.data.uid == request.auth.uid || request.auth.uid in resource.data.get('shared', [])));
      allow create: if approvedMember() && (request.resource.data.uid == request.auth.uid || (isAdmin() && canManage(request.resource.data.uid)))
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.items is list && request.resource.data.items.size() <= 60
        && request.resource.data.shared is list && request.resource.data.shared.size() <= 50;
      allow update: if approvedMember() && request.resource.data.uid == resource.data.uid
        && (resource.data.uid == request.auth.uid || (isAdmin() && canManage(resource.data.uid)))
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.items is list && request.resource.data.items.size() <= 60
        && request.resource.data.shared is list && request.resource.data.shared.size() <= 50;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || (isAdmin() && canManage(resource.data.uid)));
    }

    // Member profiles. New members always start as "pending";
    // only the admin can approve, deny or remove them.
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin()
        || (extra('viewas') && resource.data.status == 'approved' && resource.data.get('role', 'public') == 'public')
        // after a reset, the new sign-in may read the old profile to copy it
        || get(/databases/$(database)/documents/names/$(resource.data.name.lower())).data.uid == request.auth.uid);
      allow list: if isAdmin() || extra('members');
      allow create: if signedIn() && request.auth.uid == uid
        && get(/databases/$(database)/documents/names/$(request.resource.data.name.lower())).data.uid == request.auth.uid
        && ((request.resource.data.keys().hasOnly(['name', 'status', 'created', 'favs', 'email'])
             // new sign-ups give their own email and must confirm it before their request reaches the admin
             && ((request.resource.data.status == 'unverified' && request.resource.data.get('email', '') == request.auth.token.email)
                 || (request.resource.data.status == 'pending' && request.auth.token.email_verified == true)
                 || (request.resource.data.status == 'approved' && isOwner())))
          // after a reset: copy of the old profile, same name and same approval
          || (request.resource.data.keys().hasOnly(['name', 'status', 'created', 'favs', 'was', 'from', 'role', 'email', 'no', 'prefs'])
             && request.resource.data.get('no', 0) == get(/databases/$(database)/documents/users/$(request.resource.data.from)).data.get('no', 0)
             && request.resource.data.from is string
             && request.resource.data.get('role', 'public') == get(/databases/$(database)/documents/users/$(request.resource.data.from)).data.get('role', 'public')
             && get(/databases/$(database)/documents/users/$(request.resource.data.from)).data.name == request.resource.data.name
             && get(/databases/$(database)/documents/users/$(request.resource.data.from)).data.status == request.resource.data.status));
      // The owner can change anyone. Admins can change employees and public members, but can't make admins.
      allow update: if (!('no' in resource.data) || request.resource.data.get('no', 0) == resource.data.no)
        && (isOwner()
        || (isAdmin() && canManage(uid) && request.resource.data.get('role', 'public') in ['public', 'employee']
            // "from" is how a password reset hands over a profile (and the owner's place): admins never set it
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['from']))
        // employees allowed to approve people who ask to join: approve (as a customer) or deny, nothing else
        || (resource.data.status in ['pending', 'denied'] && request.resource.data.status in ['approved', 'denied']
            && request.resource.data.get('role', 'public') == 'public'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decided', 'role']) && extra('members'))
        // admins tidy up after a member's password reset (moved), on any profile but the owner's
        || (isAdmin() && uid != ownerUid() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['moved']))
        // the email link was tapped: the join request goes to the admin
        || (signedIn() && request.auth.uid == uid
            && resource.data.status == 'unverified' && request.resource.data.status == 'pending'
            && request.auth.token.email_verified == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        // a member's own confirmed email
        || (signedIn() && request.auth.uid == uid
            && resource.data.status == 'approved'
            && request.auth.token.email_verified == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email'])
            && request.resource.data.email == request.auth.token.email)
        || (signedIn() && request.auth.uid == uid
            && resource.data.status == 'approved'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favs', 'rc', 'rcAt', 'prefs', 'opened'])
            && (!('prefs' in request.resource.data) || request.resource.data.prefs is map)
            // recently opened recipes, kept with the account (up to 30)
            && (!('opened' in request.resource.data) || (request.resource.data.opened is list && request.resource.data.opened.size() <= 30)))
        // a member changing their own name: the new name must already point to them
        || (signedIn() && request.auth.uid == uid
            && resource.data.status == 'approved'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'was'])
            && request.resource.data.name is string
            && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 40
            && request.resource.data.name.lower() != 'shulem schlesinger'
            && resource.data.name.lower() != 'shulem schlesinger'
            && (!('was' in request.resource.data) || (request.resource.data.was is list && request.resource.data.was.size() <= 20))
            && get(/databases/$(database)/documents/names/$(request.resource.data.name.lower())).data.uid == request.auth.uid)
        // an admin gives an approved member their number (once)
        || (isAdmin() && !('no' in resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['no'])
            && request.resource.data.no is int && request.resource.data.no > 0));
      allow delete: if (isAdmin() && canManage(uid)) || (signedIn() && request.auth.uid == uid)
        || (signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.from == uid);
    }
  }
}
