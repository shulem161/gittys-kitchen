rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // The owner is the account saved in meta/admin. Until that exists,
    // it is whoever owns the name "Shulem Schlesinger".
    function isOwner() {
      let m = /databases/$(database)/documents/meta/admin;
      let k = /databases/$(database)/documents/names/$('shulem schlesinger');
      return signedIn()
        && ((exists(m) && get(m).data.uid == request.auth.uid)
            || (!exists(m) && exists(k) && get(k).data.uid == request.auth.uid));
    }
    function ownerUid() {
      let m = /databases/$(database)/documents/meta/admin;
      return exists(m) ? get(m).data.uid : '';
    }

    // Roles: "admin" (chosen by the owner), "employee" (what members could always do), "public" (limited).
    // A profile without a role counts as public.
    function approvedMember() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'public');
    }
    function isAdmin() { return isOwner() || (approvedMember() && myRole() == 'admin'); }
    function isTeam() { return isAdmin() || (approvedMember() && myRole() == 'employee'); }
    // Employee settings (meta/employees) for all employees; a person's own perms override them.
    function empAllow(k, d) {
      let e = /databases/$(database)/documents/meta/employees;
      return exists(e) ? get(e).data.get('allow', {}).get(k, d) : d;
    }
    // Everyday permissions: employees per Employee settings / their own perms (on unless switched off);
    // public members share meta/public (on unless switched off). Admins can always.
    function can(k) {
      let p = /databases/$(database)/documents/meta/public;
      let me = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isAdmin()
        || (approvedMember()
            && ((me.get('role', 'public') == 'employee' && me.get('perms', {}).get(k, empAllow(k, true)) == true)
                || (me.get('role', 'public') == 'public' && (!exists(p) || get(p).data.get('allow', {}).get(k, true) == true))));
    }
    // Extra permissions an admin grants one employee at a time (off unless granted).
    function extra(k) {
      let me = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isAdmin()
        || (approvedMember() && me.get('role', 'public') == 'employee' && me.get('perms', {}).get(k, empAllow(k, false)) == true);
    }
    // Who may write recipes: admins, and employees allowed to edit or to approve.
    // Those employees can't change whether the public sees a recipe; new recipes follow their category.
    function publishOk() {
      let p = /databases/$(database)/documents/meta/public;
      return isAdmin()
        || ((extra('edit') || extra('review'))
            && (resource == null
                ? request.resource.data.get('pub', true) == (!exists(p) || get(p).data.get('cats', {}).get(request.resource.data.c, true) != false)
                : request.resource.data.get('pub', null) == resource.data.get('pub', null)));
    }
    // Recipe inboxes: three different people. Whoever proofread can't approve; neither of them can release.
    // Ordinary edits never move a recipe between inboxes
    function noRvChange() {
      return resource == null || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rv', 'rvUids', 'rvAsk', 'rvLog', 'rvNote', 'rvNoteBy']);
    }
    function rvSteps() {
      let was = resource.data.get('rv', '');
      let now = request.resource.data.get('rv', '');
      return !(((was == 'approve' && now == 'release') || (was == 'release' && now == ''))
               && request.auth.uid in resource.data.get('rvUids', []));
    }
    // Admins may manage employees and public members, but never the owner or another admin.
    function canManage(uid) {
      return isOwner()
        || (isAdmin() && uid != ownerUid() && uid != request.auth.uid
            && get(/databases/$(database)/documents/users/$(uid)).data.get('role', 'public') != 'admin');
    }

    // Recipe code letters per category, and number blocks per section. Members read, only the admin writes.
    // The design everyone gets (chosen by an admin).
    match /meta/look {
      allow get: if signedIn();
      allow write: if isAdmin();
    }

    // Pairs of recipes an admin marked "not duplicates".
    match /meta/dupes {
      allow get: if isAdmin();
      allow write: if isAdmin() && request.resource.data.keys().hasOnly(['ignore']) && request.resource.data.ignore is list;
    }

    // What every employee may do (Employee settings).
    match /meta/employees {
      allow get: if signedIn();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['allow'])
        && request.resource.data.allow is map;
    }

    // What public members may do, and each category's setting for new recipes.
    match /meta/public {
      allow get: if signedIn();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['allow', 'cats'])
        && request.resource.data.allow is map && request.resource.data.cats is map;
    }
    // Member numbers: the next one to give out
    match /meta/counter {
      allow get, write: if isAdmin();
    }
    // Customers, for employees allowed to log in as one
    match /meta/customers {
      allow get: if isAdmin() || extra('viewas');
      allow write: if isAdmin() && request.resource.data.keys().hasOnly(['list']) && request.resource.data.list is list;
    }
    // Likes and dislikes on recipes: everyone rates for themselves; admins see them all.
    match /ratings/{id} {
      allow get: if signedIn() && (id.matches('.*_' + request.auth.uid) || extra('ratings'));
      allow list: if extra('ratings');
      allow create, update: if approvedMember() && id == request.resource.data.rid + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.v in [1, -1]
        && (request.resource.data.v == 1 || request.resource.data.reason in ['unclear', 'notgood', 'photo', 'amounts', 'timeheat', 'noing', 'nostep', 'hard', 'other'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 400
        && request.resource.data.keys().hasOnly(['rid', 'uid', 'name', 'v', 'reason', 'text', 'at']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    // Who hears about likes and dislikes (admins, and employees allowed to see them).
    match /meta/ratewatch {
      allow get: if approvedMember();
      allow write: if isAdmin() && request.resource.data.keys().hasOnly(['uids'])
        && request.resource.data.uids is list && request.resource.data.uids.size() <= 300;
    }
    // Who hears about new recipe requests (admins, and employees allowed to answer them).
    match /meta/reqwatch {
      allow get: if approvedMember();
      allow write: if isAdmin() && request.resource.data.keys().hasOnly(['uids'])
        && request.resource.data.uids is list && request.resource.data.uids.size() <= 300;
    }
    // Who is on the team (owner, admins, employees), so employees can pick who to write to.
    match /meta/team {
      allow get: if isTeam();
      allow write: if isAdmin() && request.resource.data.keys().hasOnly(['list'])
        && request.resource.data.list is list && request.resource.data.list.size() <= 300;
    }
    match /meta/codes {
      allow get: if signedIn();
      allow write: if isAdmin() || extra('edit') || extra('review');
    }

    // Who the owner is and the name shown for them. Only the owner can change it, and only to themselves.
    match /meta/admin {
      allow get: if true;
      allow write: if (isOwner()
            || (signedIn() && exists(/databases/$(database)/documents/meta/admin)
                && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.from == get(/databases/$(database)/documents/meta/admin).data.uid))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 40;
    }

    // One entry per member name, so every name is unique.
    match /names/{key} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email']);
      allow delete: if (isAdmin() && canManage(resource.data.uid)) || (signedIn() && resource.data.uid == request.auth.uid);
      // Someone who now signs in with their own email clears the made-up address on their name.
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email']) && request.resource.data.email == '';
      // Forgot password: a valid reset or recovery code moves the name to a new sign-in.
      allow update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'code'])
        && request.resource.data.code is string
        && exists(/databases/$(database)/documents/resets/$(request.resource.data.code))
        && get(/databases/$(database)/documents/resets/$(request.resource.data.code)).data.key == key
        && get(/databases/$(database)/documents/resets/$(request.resource.data.code)).data.uid == resource.data.uid
        && (get(/databases/$(database)/documents/resets/$(request.resource.data.code)).data.expires == null
            || get(/databases/$(database)/documents/resets/$(request.resource.data.code)).data.expires > request.time.toMillis());
    }

    // Reset codes (from the admin, 2 days) and recovery codes (made by the member, no end date).
    // The code itself is the document id and the secret: it can be read only by someone who knows it.
    match /resets/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if code.size() >= 8
        && request.resource.data.keys().hasOnly(['key', 'uid', 'by', 'created', 'expires'])
        && exists(/databases/$(database)/documents/names/$(request.resource.data.key))
        && get(/databases/$(database)/documents/names/$(request.resource.data.key)).data.uid == request.resource.data.uid
        && ((isAdmin() && canManage(request.resource.data.uid) && request.resource.data.by == 'admin'
              && request.resource.data.expires is int
              && request.resource.data.expires <= request.time.toMillis() + 3 * 86400000)
            || (signedIn() && request.resource.data.by == 'self' && code.size() >= 12
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.expires == null));
      allow delete: if isAdmin()
        || (signedIn() && (resource.data.uid == request.auth.uid
            || get(/databases/$(database)/documents/names/$(resource.data.key)).data.uid == request.auth.uid));
    }

    // Recipes: employees and admins read all; public members only recipes marked pub == true.
    // Only admins add, edit or delete.
    match /recipes/{id} {
      allow read: if isAdmin()
        || (approvedMember() && (myRole() != 'public' || resource.data.get('pub', false) == true));
      // Only admins move recipes to another category; employees ask (golive, kind "move").
      // anyone on the team can ask for a recipe to be moved up
      allow update: if isTeam() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rvAsk']);
      // anyone on the team can put a recipe into Need to proofread, so it can go public after the three steps
      allow update: if isTeam() && resource.data.get('rv', '') == '' && request.resource.data.rv == 'proof'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rv', 'rvUids', 'rvAsk', 'rvBy', 'rvAt', 'rvLog']);
      allow write: if (publishOk() && noRvChange())
        // Recipe inboxes: proofreaders, approvers and releasers move a recipe along (rv); releasers choose public or team only
        || (resource != null && (extra('proofread') || extra('review') || extra('release'))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rv', 'rvNote', 'rvNoteBy', 'rvBy', 'rvAt', 'rvUids', 'rvAsk', 'rvLog'])
            && rvSteps())
        || (resource != null && extra('release')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rv', 'rvNote', 'rvNoteBy', 'rvBy', 'rvAt', 'rvUids', 'rvAsk', 'rvLog', 'pub'])
            && rvSteps());
    }

    // Employees asking for a recipe to be shown to public members. Admins decide.
    match /golive/{id} {
      allow create: if approvedMember() && myRole() == 'employee'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.keys().hasOnly(['uid', 'byName', 'rid', 'title', 'status', 'created', 'kind', 'to', 'sec', 'from']);
      allow read: if isAdmin() || extra('release') || extra('review') || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin() || extra('release') || extra('review');
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Who hears about each recipe inbox (admins, and employees allowed to work in it).
    match /meta/{w} {
      allow get: if approvedMember() && w in ['watch-proof', 'watch-approve', 'watch-release'];
      allow write: if isAdmin() && w in ['watch-proof', 'watch-approve', 'watch-release']
        && request.resource.data.keys().hasOnly(['uids']) && request.resource.data.uids is list;
    }

    // Recipes sent in by members. Only the admin sees all of them and decides.
    match /submissions/{id} {
      allow create: if (can('suggest') || extra('edit') || isAdmin())
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if extra('review') || extra('proofread') || extra('release') || (signedIn() && resource.data.uid == request.auth.uid);
      // three different people: whoever proofread can't approve; neither of them can release
      allow update: if (extra('review') || extra('proofread') || extra('release'))
        && (request.resource.data.get('stage', '') != 'release' || resource.data.get('stage', '') == 'release'
            || !(request.auth.uid in resource.data.get('uids', [])))
        && (request.resource.data.status != 'approved' || resource.data.status == 'approved'
            || !(request.auth.uid in resource.data.get('uids', [])));
      allow delete: if extra('review')
        || (signedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'pending');
    }

    // Photos of finished dishes. Members' photos wait for an admin's approval.
    match /photos/{id} {
      allow create: if can('photos')
        && request.resource.data.uid == request.auth.uid
        && (request.resource.data.status == 'pending'
            || (request.resource.data.status == 'approved' && extra('review')))
        && request.resource.data.img is string && request.resource.data.img.size() < 900000
        && request.resource.data.thumb is string && request.resource.data.thumb.size() < 80000;
      allow read: if extra('review')
        || (signedIn() && resource.data.uid == request.auth.uid)
        || (resource.data.status == 'approved' && approvedMember());
      allow update: if extra('review');
      allow delete: if extra('review')
        || (signedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'pending');
    }

    // Suggestions and comments from members. Only the admin sees them all and can reply.
    match /feedback/{id} {
      allow create: if can('feedback')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.reply == ''
        && request.resource.data.text is string && request.resource.data.text.size() <= 1500;
      allow read: if extra('inbox') || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if extra('inbox');
      allow delete: if extra('inbox') || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Recipe requests from members ("I need a recipe for…", optional small photo). Only the admin sees them all.
    match /requests/{id} {
      allow create: if can('requests')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.reply == '' && request.resource.data.recipeId == ''
        && request.resource.data.items is list && request.resource.data.items.size() <= 12
        && request.resource.data.text is string && request.resource.data.text.size() <= 800
        && request.resource.data.photo is string && request.resource.data.photo.size() < 120000;
      allow read: if extra('answer') || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if extra('answer');
      allow delete: if extra('answer') || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Each person's own calendar: only they can see or change it.
    match /plans/{uid} {
      allow read, write: if approvedMember() && request.auth.uid == uid;
      // "Log in as": admins, and employees allowed to look in as a customer
      allow read: if isAdmin() || (extra('viewas') && get(/databases/$(database)/documents/users/$(uid)).data.get('role', 'public') == 'public');
    }

    // Menus: the person who made one changes it; people it's shared with can read it.
    // Phone notices: each person's own private ntfy topic. Members may read it to send them a notice.
    match /notify/{uid} {
      allow get: if approvedMember();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['topic'])
        && request.resource.data.topic is string
        && request.resource.data.topic.size() >= 16 && request.resource.data.topic.size() <= 64;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Team messages: only employees and admins, and only the people in the conversation.
    match /threads/{id} {
      allow read: if (isTeam() && request.auth.uid in resource.data.members) || isAdmin();
      allow create: if isTeam()
        && request.resource.data.by == request.auth.uid && request.resource.data.lastBy == request.auth.uid
        && request.resource.data.members is list && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() <= 300
        && request.resource.data.msgs is list && request.resource.data.msgs.size() == 1
        && request.resource.data.msgs[0].by == request.auth.uid
        && request.resource.data.msgs[0].text is string && request.resource.data.msgs[0].text.size() <= 1500;
      allow update: if isTeam() && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['msgs', 'updated', 'lastBy', 'readAt', 'done', 'checks'])
        // proofreading: each person marks only their own check
        && (!('checks' in request.resource.data) || request.resource.data.checks.diff(resource.data.get('checks', {})).affectedKeys().hasOnly([request.auth.uid]))
        && request.resource.data.msgs is list && request.resource.data.msgs.size() <= 200
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastBy'])
            || request.resource.data.lastBy == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /menus/{id} {
      allow read: if isAdmin() || (approvedMember()
        && (resource.data.uid == request.auth.uid || request.auth.uid in resource.data.get('shared', [])));
      allow create: if approvedMember() && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.items is list && request.resource.data.items.size() <= 60
        && request.resource.data.shared is list && request.resource.data.shared.size() <= 50;
      allow update: if approvedMember() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.items is list && request.resource.data.items.size() <= 60
        && request.resource.data.shared is list && request.resource.data.shared.size() <= 50;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Member profiles. New members always start as "pending";
    // only the admin can approve, deny or remove them.
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin()
        || (extra('viewas') && resource.data.status == 'approved' && resource.data.get('role', 'public') == 'public')
        // after a reset, the new sign-in may read the old profile to copy it
        || get(/databases/$(database)/documents/names/$(resource.data.name.lower())).data.uid == request.auth.uid);
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && get(/databases/$(database)/documents/names/$(request.resource.data.name.lower())).data.uid == request.auth.uid
        && ((request.resource.data.keys().hasOnly(['name', 'status', 'created', 'favs', 'email'])
             // new sign-ups give their own email and must confirm it before their request reaches the admin
             && ((request.resource.data.status == 'unverified' && request.resource.data.get('email', '') == request.auth.token.email)
                 || (request.resource.data.status == 'pending' && request.auth.token.email_verified == true)
                 || (request.resource.data.status == 'approved' && isOwner())))
          // after a reset: copy of the old profile, same name and same approval
          || (request.resource.data.keys().hasOnly(['name', 'status', 'created', 'favs', 'was', 'from', 'role', 'email', 'no', 'prefs'])
             && request.resource.data.get('no', 0) == get(/databases/$(database)/documents/users/$(request.resource.data.from)).data.get('no', 0)
             && request.resource.data.from is string
             && request.resource.data.get('role', 'public') == get(/databases/$(database)/documents/users/$(request.resource.data.from)).data.get('role', 'public')
             && get(/databases/$(database)/documents/users/$(request.resource.data.from)).data.name == request.resource.data.name
             && get(/databases/$(database)/documents/users/$(request.resource.data.from)).data.status == request.resource.data.status));
      // The owner can change anyone. Admins can change employees and public members, but can't make admins.
      allow update: if (!('no' in resource.data) || request.resource.data.get('no', 0) == resource.data.no)
        && (isOwner()
        || (isAdmin() && canManage(uid) && request.resource.data.get('role', 'public') in ['public', 'employee'])
        // admins tidy up after a member's password reset (moved), on any profile but the owner's
        || (isAdmin() && uid != ownerUid() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['moved']))
        // the email link was tapped: the join request goes to the admin
        || (signedIn() && request.auth.uid == uid
            && resource.data.status == 'unverified' && request.resource.data.status == 'pending'
            && request.auth.token.email_verified == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        // a member's own confirmed email
        || (signedIn() && request.auth.uid == uid
            && resource.data.status == 'approved'
            && request.auth.token.email_verified == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email'])
            && request.resource.data.email == request.auth.token.email)
        || (signedIn() && request.auth.uid == uid
            && resource.data.status == 'approved'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favs', 'rc', 'rcAt', 'prefs'])
            && (!('prefs' in request.resource.data) || request.resource.data.prefs is map))
        // a member changing their own name: the new name must already point to them
        || (signedIn() && request.auth.uid == uid
            && resource.data.status == 'approved'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'was'])
            && request.resource.data.name is string
            && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 40
            && request.resource.data.name.lower() != 'shulem schlesinger'
            && resource.data.name.lower() != 'shulem schlesinger'
            && (!('was' in request.resource.data) || (request.resource.data.was is list && request.resource.data.was.size() <= 20))
            && get(/databases/$(database)/documents/names/$(request.resource.data.name.lower())).data.uid == request.auth.uid)
        // an admin gives an approved member their number (once)
        || (isAdmin() && !('no' in resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['no'])
            && request.resource.data.no is int && request.resource.data.no > 1000));
      allow delete: if (isAdmin() && canManage(uid)) || (signedIn() && request.auth.uid == uid)
        || (signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.from == uid);
    }
  }
}
