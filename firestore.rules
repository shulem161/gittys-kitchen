rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // The admin is the account saved in meta/admin. Until that exists,
    // it is whoever owns the name "Shulem Schlesinger".
    function isAdmin() {
      let m = /databases/$(database)/documents/meta/admin;
      let k = /databases/$(database)/documents/names/$('shulem schlesinger');
      return signedIn()
        && ((exists(m) && get(m).data.uid == request.auth.uid)
            || (!exists(m) && exists(k) && get(k).data.uid == request.auth.uid));
    }

    // Who the admin is and the name shown for them. Only the admin can change it, and only to themselves.
    match /meta/admin {
      allow get: if true;
      allow write: if isAdmin()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 40;
    }

    // One entry per member name, so every name is unique.
    match /names/{key} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email']);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Recipes: approved members can read, only the admin can add, edit or delete.
    match /recipes/{id} {
      allow read: if isAdmin()
        || (signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved');
      allow write: if isAdmin();
    }

    // Recipes sent in by members. Only the admin sees all of them and decides.
    match /submissions/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'pending');
    }

    // Photos of finished dishes. Members' photos wait for the admin's approval.
    function approvedMember() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }
    match /photos/{id} {
      allow create: if approvedMember()
        && request.resource.data.uid == request.auth.uid
        && (request.resource.data.status == 'pending'
            || (request.resource.data.status == 'approved' && isAdmin()))
        && request.resource.data.img is string && request.resource.data.img.size() < 900000
        && request.resource.data.thumb is string && request.resource.data.thumb.size() < 80000;
      allow read: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid)
        || (resource.data.status == 'approved' && approvedMember());
      allow update: if isAdmin();
      allow delete: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'pending');
    }

    // Suggestions and comments from members. Only the admin sees them all and can reply.
    match /feedback/{id} {
      allow create: if approvedMember()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.reply == ''
        && request.resource.data.text is string && request.resource.data.text.size() <= 1500;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Member profiles. New members always start as "pending";
    // only the admin can approve, deny or remove them.
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'status', 'created', 'favs'])
        && get(/databases/$(database)/documents/names/$(request.resource.data.name.lower())).data.uid == request.auth.uid
        && (request.resource.data.status == 'pending'
            || (request.resource.data.status == 'approved' && isAdmin()));
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && resource.data.status == 'approved'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favs']))
        // a member changing their own name: the new name must already point to them
        || (signedIn() && request.auth.uid == uid
            && resource.data.status == 'approved'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'was'])
            && request.resource.data.name is string
            && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 40
            && request.resource.data.name.lower() != 'shulem schlesinger'
            && resource.data.name.lower() != 'shulem schlesinger'
            && (!('was' in request.resource.data) || (request.resource.data.was is list && request.resource.data.was.size() <= 20))
            && get(/databases/$(database)/documents/names/$(request.resource.data.name.lower())).data.uid == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }
  }
}
